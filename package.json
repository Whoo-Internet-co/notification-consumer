{
  "name": "notification-consumer",
  "version": "1.0.0",
  "private": true,
  "description": "Idempotent SQS consumer that simulates transaction notifications",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.883.0",
    "@whoo-internet-co/finance-platform-contracts": "^1.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.1"
  }
}
